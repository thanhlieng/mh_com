# Production Environment Variables
NODE_ENV=production

# Application config
APP_PORT=3002
WEB_URL=https://yourdomain.com

# Domain configuration
DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=your-email@yourdomain.com

# Database config
DB_TYPE=postgres
DB_PORT=5432
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_DATABASE=mh_database
DB_HOST=db
DB_USER=mh_user
DB_PASS=your_secure_password_here

# JWT config
JWT_EXPIRES_IN=200d
JWT_SECRET=your_jwt_secret_key_here_change_this
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=30m

# BCrypt config
BCRYPT_SALT_ROUNDS=10

# ACF CONFIG
ACF_DEFAULT_PASSWORD=Acf08092021
ACF_CUSTOMER_ACCOUNT_START=31700000
ACF_BOOKING_CODE_START=893080920210000
EMAIL_CREATE_USER=admin@yourdomain.com
DEFAULT_PU_DELIVERY_CODE=PUP00000001
PATH_CHROME=/usr/bin/chromium-browser

# Storage Configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/uploads
LOCAL_STORAGE_URL=https://yourdomain.com/uploads

# AWS S3 Config (Optional - if you want to use S3)
# AWS_ACCESS_KEY=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_BUCKET=your_s3_bucket_name
# AWS_REGION=ap-southeast-1

# Cloudflare R2 Config (Optional)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_TOKEN=your_token
# CLOUDFLARE_BUCKET=your_bucket

# Backblaze B2 Config (Optional)
# BACKBLAZE_ENDPOINT=your_endpoint
# BACKBLAZE_KEY_ID=your_key_id
# BACKBLAZE_KEY=your_key
# BACKBLAZE_BUCKET=your_bucket

EMAIL_SEND=info@yourdomain.com

# Email configurations
EMAIL_RECEIVE_CREATE_CUSTOMER=admin@yourdomain.com
EMAIL_RECEIVE_HANDLE_BOOKING=admin@yourdomain.com
EMAIL_RECEIVE_CUSTOMER_SERVICE=admin@yourdomain.com
EMAIL_POD=admin@yourdomain.com
EMAIL_RECEIVE_MANIFEST=admin@yourdomain.com
EMAIL_RECEIVE_ERROR=admin@yourdomain.com
EMAIL_RECEIVE_MANIFEST_YAMATO=admin@yourdomain.com
EMAIL_RECEIVE_CARGO_LIST=admin@yourdomain.com

# Aftership config
AFTERSHIP_SECRET_KEY=your_aftership_secret_key
AFTERSHIP_TRACKING_URL=https://api.aftership.com

# Sharepoint config (if needed)
SHARE_POINT_TENANT_ID=your_sharepoint_tenant_id
SHARE_POINT_CLIENT_ID=your_sharepoint_client_id
SHARE_POINT_CLIENT_SECRET=your_sharepoint_client_secret

# Postcode data configuration (replaces Google Sheets)
POSTCODE_DATA_PATH=./data
POSTCODE_FILE_NAME=postcode.csv
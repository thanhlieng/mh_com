{
  "name": "mh-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "node --max-old-space-size=8192 ./node_modules/.bin/nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "create:module": "nest g mo modules/$name",
    "create:controller": "nest g co modules/ml-exchange-rate",
    "create:service": "nest g s modules/ml-exchange-rate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "seed:user": "npx nestjs-command create:user",
    "seed:company": "npx nestjs-command create:company",
    "seed:homepage": "npx nestjs-command create:homepage",
    "seed:category": "npx nestjs-command create:category",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node --project ./tsconfig.json -r tsconfig-paths/register ./node_modules/typeorm/cli -d ./src/configs/database/typeorm.config.ts",
    "db:gen": "cross-env yarn typeorm migration:generate ./src/configs/database/migrations/$name",
    "db:create": "typeorm migration:generate ./src/configs/database/migrations/$name",
    "db:run": "cross-env npm run typeorm migration:run",
    "db:rollback": "cross-env yarn typeorm migration:revert"
  },
  "dependencies": {
    "@azure/identity": "^3.1.3",
    "@golevelup/nestjs-discovery": "^3.0.0",
    "@microsoft/microsoft-graph-client": "3.0.0",
    "@nestjs/axios": "^1.0.1",
    "@nestjs/common": "^8.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^8.0.0",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^8.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^8.2.1",
    "@nestjs/platform-express": "^8.0.0",
    "@nestjs/schedule": "^1.1.0",
    "@nestjs/swagger": "^5.2.1",
    "@nestjs/typeorm": "^10.0.2",
    "@types/archiver": "^6.0.2",
    "@types/multer": "^1.4.7",
    "archiver": "^6.0.1",
    "async-mutex": "^0.4.0",
    "axios": "^1.2.2",
    "bcrypt": "^5.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0",
    "dayjs": "^1.11.1",
    "dotenv": "^16.0.0",
    "exceljs": "^4.4.0",
    "imap": "^0.8.19",
    "isomorphic-fetch": "^3.0.0",
    "jsbarcode": "^3.11.5",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mailcomposer": "^4.0.2",
    "memory-streams": "^0.1.3",
    "moment": "^2.29.2",
    "nestjs-command": "^3.1.2",
    "newrelic": "^8.14.1",
    "node-xlsx": "^0.21.0",
    "passport": "^0.5.2",
    "passport-jwt": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.14.1",
    "puppeteer": "^19.4.1",
    "reflect-metadata": "^0.1.13",
    "remove-accents": "^0.5.0",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "swagger-ui-express": "^4.3.0",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0",
    "winston": "^3.7.2",
    "winston-daily-rotate-file": "^4.6.1",
    "xlsx": "^0.18.5",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^8.2.5",
    "@nestjs/schematics": "^8.0.0",
    "@nestjs/testing": "^8.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cron": "^1.7.3",
    "@types/express": "^4.17.13",
    "@types/imap": "^0.8.35",
    "@types/jest": "27.4.0",
    "@types/node": "^16.0.0",
    "@types/passport-jwt": "^3.0.6",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^27.2.5",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "^27.0.3",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^3.10.1",
    "typescript": "^4.3.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}

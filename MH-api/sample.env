NODE_ENV=develop
# Application config
APP_PORT=8080
WEB_URL=

# Storage config
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL=http://localhost:8080/uploads

# Database config
DB_TYPE=
DB_PORT=
DB_SYNCHRONIZE=true
DB_LOGGING=false

## DB CONFIG ##
DB_DATABASE=
DB_HOST=
DB_USER=
DB_PASS=


# JWT config
JWT_EXPIRES_IN=200d
JWT_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=30m

# BCrypt config
BCRYPT_SALT_ROUNDS=10

# ACF CONFIG
ACF_DEFAULT_PASSWORD=
ACF_CUSTOMER_ACCOUNT_START=
ACF_BOOKING_CODE_START=
EMAIL_CREATE_USER=
DEFAULT_PU_DELIVERY_CODE=
PATH_CHROME=

#AWS CONFIG - removed, using local storage
# AWS_ACCESS_KEY=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
EMAIL_SEND=
EMAIL_RECEIVE_CREATE_CUSTOMER=
EMAIL_RECEIVE_HANDLE_BOOKING=
EMAIL_RECEIVE_CUSTOMER_SERVICE=
EMAIL_POD=
EMAIL_RECEIVE_MANIFEST=
EMAIL_RECEIVE_ERROR=

#Aftership key
AFTERSHIP_SECRET_KEY=
AFTERSHIP_TRACKING_URL=

# mhcom → mhvn Integration (RS256 JWT)
MHCOM_PRIVATE_KEY_PATH=./certs/com_vn.pem
MHVN_API_BASE_URL=http://localhost:8000